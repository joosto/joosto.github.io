{{ template "header" .PageData }}
<header>
    <p>
        <b>I'm Joost 👋️</b> &mdash; I'm a Staff Engineer at <a href="https://monzo.com/">Monzo</a>. I've spent most the past decade building payments systems and ledgers, but at the moment my focus is building AI agents to automate operational work.
    </p>
    <span id="about-me">
    You can find me on <a href="https://www.linkedin.com/in/joost-van-oorschot-grant-852aa296/">LinkedIn</a>.
    </span>
</header>
{{- /*gotype: joosto.github.io.IndexData*/ -}}
<h1>📕 Blog</h1>
<p>
I write a new blog post every few years...
</p>
<div id="posts">
    {{ range .Posts }}
        {{ if .URL }}
            <a href="{{.URL}}"><h2>{{.Title}}</h2></a> <!-- todo: remove .html -->
        {{ else }}
            <a href="/posts/{{.Slug}}.html"><h2>{{.Title}}</h2></a> <!-- todo: remove .html -->
        {{ end }}
        <p>{{.Date}} &mdash; {{.Summary}}</p>
    {{ end }}
</div>
{{ template "footer" }}
